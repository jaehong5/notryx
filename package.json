{
  "name": "notryx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/client"],
  "engines": { "node": "24.22.1" },
  "scripts": {
    "dev": "npm run dev --workspace @notryx/client",
    "build": "npm run build --workspace @notryx/client",
    "typecheck": "npm run typecheck --workspace @notryx/client",
    "lint": "eslint apps/client/src",
    "test": "vitest run",
    "tauri": "npm run --workspace @notryx/client tauri --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
